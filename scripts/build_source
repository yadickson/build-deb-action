#!/bin/sh

set -eu

cd -- "${INPUT_SOURCE_DIR}"

pkg=$(dpkg-parsechangelog --show-field Source || dpkg-parsechangelog | sed -n 's/^Source: //p')
version=$(dpkg-parsechangelog --show-field Version || dpkg-parsechangelog | sed -n 's/^Version: //p')

tar --exclude-vcs --exclude=debian --create --gzip --verbose --file="../${pkg}_${version}.orig.tar.gz" .
