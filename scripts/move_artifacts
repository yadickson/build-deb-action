#!/bin/bash

set -eu

cd -- "${INPUT_SOURCE_DIR}"

version=$(dpkg-parsechangelog -l"debian/changelog" | LANG=C perl -ne 'print $1 if m{^Version:\s+(?:\d+:)?(\d.*)(?:\-\d+.*)};')

mkdir -p "${GITHUB_WORKSPACE}/${INPUT_ARTIFACTS_DIR}"

find ".." -maxdepth 1 -name "*${version}*.*" -type f -print -exec mv '{}' "${GITHUB_WORKSPACE}/${INPUT_ARTIFACTS_DIR}/" \;