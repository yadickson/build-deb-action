#!/bin/bash

set -eu

APT_CONF_FILE=/etc/apt/apt.conf.d/50build-deb-action

export DEBIAN_FRONTEND=noninteractive

cat >"$APT_CONF_FILE" <<-EOF
	APT::Get::Assume-Yes "yes";
	APT::Install-Recommends "no";
  APT::Install-Suggests "no";
  APT::Get::Install-Recommends "false";
  APT::Get::Install-Suggests "false";
	Acquire::Languages "none";
	quiet "yes";
EOF

OS_ID=$(cat /etc/os-release | perl -ne 'print $1 if m{^ID=(.*)};') || true
OS_VERSION=$(cat /etc/os-release | perl -ne 'print $1 if m{^VERSION_ID="(.*)"};') || true

if [ -z "$INPUT_MAIN_REPOS" ]; then
  if [ "${OS_ID}" = "debian" ] && [ "${OS_VERSION}" = "7" ]; then
    INPUT_MAIN_REPOS="
deb [trusted=yes] http://archive.debian.org/debian/ wheezy main contrib
deb [trusted=yes] http://archive.debian.org/debian-security/ wheezy/updates main contrib
"
  elif [ "${OS_ID}" = "debian" ] && [ "${OS_VERSION}" = "8" ]; then
    INPUT_MAIN_REPOS="
deb [trusted=yes] http://archive.debian.org/debian/ jessie main contrib
deb [trusted=yes] http://archive.debian.org/debian-security/ jessie/updates main contrib
"
  elif [ "${OS_ID}" = "debian" ] && [ "${OS_VERSION}" = "9" ]; then
    INPUT_MAIN_REPOS="
deb [trusted=yes] http://archive.debian.org/debian/ stretch main contrib
deb [trusted=yes] http://archive.debian.org/debian-security/ stretch/updates main contrib
"
  elif [ "${OS_ID}" = "debian" ] && [ "${OS_VERSION}" = "10" ]; then
    INPUT_MAIN_REPOS="
deb [trusted=yes] http://archive.debian.org/debian/ buster main contrib
deb [trusted=yes] http://archive.debian.org/debian/ buster-updates main contrib
deb [trusted=yes] http://archive.debian.org/debian-security/ buster/updates main contrib
"
  elif [ "${OS_ID}" = "debian" ] && [ "${OS_VERSION}" = "11" ]; then
    INPUT_MAIN_REPOS="
deb [trusted=yes] http://archive.debian.org/debian/ bullseye main contrib
deb [trusted=yes] http://archive.debian.org/debian/ bullseye-updates main contrib
deb [trusted=yes] http://archive.debian.org/debian-security/ bullseye-security main contrib
"
  fi
fi

# Adapted from pbuilder's and sbuild's support for cross-building:
if [ -n "$INPUT_HOST_ARCH" ]; then
	dpkg --add-architecture "$INPUT_HOST_ARCH"
	INPUT_EXTRA_BUILD_DEPS="$INPUT_EXTRA_BUILD_DEPS crossbuild-essential-$INPUT_HOST_ARCH libc-dev:$INPUT_HOST_ARCH"
	printf 'APT::Get::Host-Architecture "%s";\n' "$INPUT_HOST_ARCH" >>"$APT_CONF_FILE"
fi

# debconf has priority “required” and is indirectly depended on by some
# essential packages. It is reasonably safe to blindly assume it is installed.
printf "man-db man-db/auto-update boolean false\n" | debconf-set-selections

if [ -n "$INPUT_MAIN_REPOS" ]; then
  printf "%s\n" "" > "/etc/apt/sources.list"
  printf "%s\n" "" > "/etc/apt/sources.sources"
	if printf "%s\n" "$INPUT_MAIN_REPOS" | grep -q '^deb'; then
		main_repos_ext=.list
	else
		main_repos_ext=.sources
	fi
	printf "%s\n" "$INPUT_MAIN_REPOS" >"/etc/apt/sources${main_repos_ext}"
fi

if [ -n "$INPUT_BACKPORT_REPOS" ]; then
	if printf "%s\n" "$INPUT_BACKPORT_REPOS" | grep -q '^deb'; then
		backport_repos_ext=.list
	else
		backport_repos_ext=.sources
	fi
	printf "%s\n" "$INPUT_BACKPORT_REPOS" >"/etc/apt/sources.d/backport-repos${backport_repos_ext}"
fi

if [ -n "$INPUT_EXTRA_REPOS" ]; then
	if printf "%s\n" "$INPUT_EXTRA_REPOS" | grep -q '^deb'; then
		extra_repos_ext=.list
	else
		extra_repos_ext=.sources
	fi
	printf "%s\n" "${INPUT_EXTRA_REPOS}" >"/etc/apt/sources.list.d/extra-repos${extra_repos_ext}"
fi

# fix to install default-jdk, ca-certificates-java into old distributions
mkdir -p /usr/share/man/man1

apt-get update
apt-get upgrade -y

# In theory, explicitly installing dpkg-dev would not be necessary. `apt-get
# build-dep` will *always* install build-essential which depends on dpkg-dev.
# But let’s be explicit here.
# shellcheck disable=SC2086
apt-get install ${INPUT_APT_OPTS} -- devscripts equivs dpkg-dev lintian tar ${INPUT_EXTRA_BUILD_DEPS}
# shellcheck disable=SC2086
apt-get install ${INPUT_APT_OPTS} -- libparse-debcontrol-perl || true
