#!/bin/sh

set -eu

cd -- "${INPUT_SOURCE_DIR}"

pkg=$(dpkg-parsechangelog | sed -n 's/^Source: //p')
version=$(dpkg-parsechangelog | perl -ne 'print $$1 if m{^Version:\s+(?:\d+:)?(\d.*)(?:\-\d+.*)};')

tar --exclude-vcs --exclude=debian --create --gzip --verbose --file="../${pkg}_${version}.orig.tar.gz" .
